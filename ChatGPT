//====================================================================
// CSV LOG
//====================================================================

void LogTradeCSV(
   string action,
   string pattern,
   double entry,
   double sl,
   double tp,
   double lot,
   double referenceLevel,
   double targetLevel,
   double rr
)
{
   if(!EnableCSVLogging)
      return;

   int file =
      FileOpen(
         CSVFileName,
         FILE_READ |
         FILE_WRITE |
         FILE_CSV |
         FILE_SHARE_READ |
         FILE_SHARE_WRITE,
         ','
      );

   if(file == INVALID_HANDLE)
   {
      Print(
         "CSV open failed. Error=",
         GetLastError()
      );

      return;
   }

   //---------------------------------------------------------------
   // Header
   //---------------------------------------------------------------

   if(FileSize(file) == 0)
   {
      FileWrite(
         file,
         "Time",
         "Symbol",
         "Action",
         "Pattern",
         "Entry",
         "SL",
         "TP",
         "Lot",
         "ReferenceLevel",
         "TargetLevel",
         "RR",
         "SpreadPoints"
      );
   }

   FileSeek(
      file,
      0,
      SEEK_END
   );

   FileWrite(
      file,
      TimeToString(
         TimeCurrent(),
         TIME_DATE |
         TIME_SECONDS
      ),
      TradeSymbol,
      action,
      pattern,
      DoubleToString(
         entry,
         DigitsSymbol()
      ),
      DoubleToString(
         sl,
         DigitsSymbol()
      ),
      DoubleToString(
         tp,
         DigitsSymbol()
      ),
      DoubleToString(
         lot,
         VolumeDigits()
      ),
      DoubleToString(
         referenceLevel,
         DigitsSymbol()
      ),
      DoubleToString(
         targetLevel,
         DigitsSymbol()
      ),
      DoubleToString(
         rr,
         2
      ),
      DoubleToString(
         GetSpreadPoints(),
         1
      )
   );

   FileClose(file);
}
