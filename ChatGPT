//+------------------------------------------------------------------+
//| XAUUSD Liquidity Sweep M15 EA                                    |
//| EMA + RSI + ATR + Candlestick + Liquidity Sweep                 |
//| Previous Swing High/Low SL & TP                                  |
//+------------------------------------------------------------------+
#property strict
#property version   "1.00"
#property description "XAUUSD M15 Liquidity Sweep Strategy"
#property description "Use on demo/backtest before live deployment."

#include <Trade/Trade.mqh>

CTrade trade;

//====================================================================
// GENERAL
//====================================================================

input string          TradeSymbol       = "XAUUSD";
input ENUM_TIMEFRAMES TradeTimeframe    = PERIOD_M15;
input ulong           MagicNumber       = 17092026;

//====================================================================
// RISK
//====================================================================

input double RiskPercent               = 1.0;
input double MinimumRiskReward         = 2.0;

input int    MaxOpenPositions          = 1;
input int    MaxDailyTrades            = 2;
input double MaxDailyLossPercent       = 2.0;

//====================================================================
// INDICATORS
//====================================================================

input int EMAFastPeriod                = 20;
input int EMAMidPeriod                 = 50;
input int EMASlowPeriod                = 200;

input int RSIPeriod                    = 14;
input double RSILevel                  = 50.0;

input int ATRPeriod                    = 14;

//====================================================================
// PULLBACK
//====================================================================

input double PullbackATRMultiplier     = 0.25;

//====================================================================
// SWING
//====================================================================

input int SwingLookback                = 100;

//====================================================================
// STOP LOSS
//====================================================================

// BUY:
//     SL = swept swing LOW - ATR buffer
//
// SELL:
//     SL = swept swing HIGH + ATR buffer

input double SL_ATR_Buffer             = 0.20;

//====================================================================
// TAKE PROFIT
//====================================================================

// TP is based on opposite confirmed swing.
// Minimum RR must be satisfied.

input bool RequireMinimumRR            = true;

//====================================================================
// LIQUIDITY SWEEP
//====================================================================

input bool RequireLiquiditySweep       = true;

// BUY:
//
// confirmation candle LOW < previous confirmed swing LOW
// AND
// confirmation candle CLOSE > previous confirmed swing LOW
//
// SELL:
//
// confirmation candle HIGH > previous confirmed swing HIGH
// AND
// confirmation candle CLOSE < previous confirmed swing HIGH

//====================================================================
// CANDLE PATTERN
//====================================================================

input bool UseCandlestickFilter        = true;

// BUY patterns
input bool EnableBullishEngulfing      = true;
input bool EnableHammer                = true;
input bool EnableDragonflyDoji         = true;
input bool EnableInvertedHammer        = true;
input bool EnableBullishInsideBar      = true;

// SELL patterns
input bool EnableBearishEngulfing      = true;
input bool EnableShootingStar           = true;
input bool EnableGravestoneDoji         = true;
input bool EnableHangingMan             = true;
input bool EnableBearishInsideBar       = true;

//====================================================================
// CANDLE WICK SETTINGS
//====================================================================

input double HammerLowerWickRatio       = 2.5;
input double HammerUpperWickMaxRatio    = 1.0;

input double ShootingUpperWickRatio     = 2.5;
input double ShootingLowerWickMaxRatio  = 1.0;

input double DojiBodyPercent            = 0.10;

//====================================================================
// PREVIOUS CANDLE DIRECTION
//====================================================================

input bool BuyPatternRequiresPrevRed    = true;
input bool SellPatternRequiresPrevGreen = true;

//====================================================================
// SESSION FILTER
// Broker SERVER TIME
//====================================================================

input bool UseLondonSession             = true;
input string LondonStart                = "08:00";
input string LondonEnd                  = "12:00";

input bool UseNewYorkSession            = true;
input string NewYorkStart               = "13:00";
input string NewYorkEnd                 = "17:00";

//====================================================================
// SPREAD
//====================================================================

input double MaxSpreadPoints            = 50.0;

//====================================================================
// LOGGING
//====================================================================

input bool EnableDetailedLogging        = true;
input bool EnableCSVLogging             = true;

string CSVFileName = "XAUUSD_LiquiditySweep_Trades.csv";

//====================================================================
// INDICATOR HANDLES
//====================================================================

int EMA20Handle  = INVALID_HANDLE;
int EMA50Handle  = INVALID_HANDLE;
int EMA200Handle = INVALID_HANDLE;
int RSIHandle    = INVALID_HANDLE;
int ATRHandle    = INVALID_HANDLE;
int FractalHandle = INVALID_HANDLE;

//====================================================================
// GLOBAL
//====================================================================

datetime LastBarTime = 0;

//====================================================================
// INITIALIZATION
//====================================================================

int OnInit()
{
   Print("====================================================");
   Print("XAUUSD LIQUIDITY SWEEP EA STARTING");
   Print("====================================================");

   if(!SymbolSelect(TradeSymbol, true))
   {
      Print("ERROR: Cannot select symbol: ", TradeSymbol);
      return INIT_FAILED;
   }

   EMA20Handle =
      iMA(
         TradeSymbol,
         TradeTimeframe,
         EMAFastPeriod,
         0,
         MODE_EMA,
         PRICE_CLOSE
      );

   EMA50Handle =
      iMA(
         TradeSymbol,
         TradeTimeframe,
         EMAMidPeriod,
         0,
         MODE_EMA,
         PRICE_CLOSE
      );

   EMA200Handle =
      iMA(
         TradeSymbol,
         TradeTimeframe,
         EMASlowPeriod,
         0,
         MODE_EMA,
         PRICE_CLOSE
      );

   RSIHandle =
      iRSI(
         TradeSymbol,
         TradeTimeframe,
         RSIPeriod,
         PRICE_CLOSE
      );

   ATRHandle =
      iATR(
         TradeSymbol,
         TradeTimeframe,
         ATRPeriod
      );

   FractalHandle =
      iFractals(
         TradeSymbol,
         TradeTimeframe
      );

   if(
      EMA20Handle == INVALID_HANDLE ||
      EMA50Handle == INVALID_HANDLE ||
      EMA200Handle == INVALID_HANDLE ||
      RSIHandle == INVALID_HANDLE ||
      ATRHandle == INVALID_HANDLE ||
      FractalHandle == INVALID_HANDLE
   )
   {
      Print("ERROR: Indicator initialization failed.");
      return INIT_FAILED;
   }

   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetTypeFillingBySymbol(TradeSymbol);

   Print("Symbol          : ", TradeSymbol);
   Print("Timeframe       : M15");
   Print("Risk            : ", RiskPercent, "%");
   Print("Minimum RR      : ", MinimumRiskReward);
   Print("Liquidity Sweep : ", RequireLiquiditySweep);
   Print("CSV Logging     : ", EnableCSVLogging);
   Print("EA READY");

   return INIT_SUCCEEDED;
}

//====================================================================
// DEINITIALIZATION
//====================================================================

void OnDeinit(const int reason)
{
   if(EMA20Handle != INVALID_HANDLE)
      IndicatorRelease(EMA20Handle);

   if(EMA50Handle != INVALID_HANDLE)
      IndicatorRelease(EMA50Handle);

   if(EMA200Handle != INVALID_HANDLE)
      IndicatorRelease(EMA200Handle);

   if(RSIHandle != INVALID_HANDLE)
      IndicatorRelease(RSIHandle);

   if(ATRHandle != INVALID_HANDLE)
      IndicatorRelease(ATRHandle);

   if(FractalHandle != INVALID_HANDLE)
      IndicatorRelease(FractalHandle);

   Print("EA stopped.");
}

//====================================================================
// ON TICK
//====================================================================

void OnTick()
{
   if(!IsNewBar())
      return;

   ProcessSignal();
}

//====================================================================
// NEW BAR
//====================================================================

bool IsNewBar()
{
   datetime barTime =
      iTime(
         TradeSymbol,
         TradeTimeframe,
         0
      );

   if(barTime <= 0)
      return false;

   if(barTime == LastBarTime)
      return false;

   LastBarTime = barTime;

   Print("----------------------------------------------------");
   Print(
      "NEW M15 BAR: ",
      TimeToString(barTime, TIME_DATE | TIME_MINUTES)
   );

   return true;
}

//====================================================================
// MAIN PROCESS
//====================================================================

void ProcessSignal()
{
   Print("Checking strategy...");

   //---------------------------------------------------------------
   // SESSION
   //---------------------------------------------------------------

   if(!IsTradingSession())
   {
      Print("REJECT: Outside trading session.");
      return;
   }

   //---------------------------------------------------------------
   // SPREAD
   //---------------------------------------------------------------

   double spread = GetSpreadPoints();

   if(spread > MaxSpreadPoints)
   {
      Print(
         "REJECT: Spread too high = ",
         DoubleToString(spread, 1),
         " points. Maximum = ",
         MaxSpreadPoints
      );

      return;
   }

   //---------------------------------------------------------------
   // DAILY LOSS
   //---------------------------------------------------------------

   if(!CheckDailyLoss())
   {
      Print("REJECT: Daily loss limit reached.");
      return;
   }

   //---------------------------------------------------------------
   // DAILY TRADES
   //---------------------------------------------------------------

   if(!CheckDailyTradeLimit())
   {
      Print("REJECT: Maximum daily trades reached.");
      return;
   }

   //---------------------------------------------------------------
   // OPEN POSITION
   //---------------------------------------------------------------

   if(CountOurPositions() >= MaxOpenPositions)
   {
      Print("REJECT: Existing position already open.");
      return;
   }

   //---------------------------------------------------------------
   // INDICATORS
   //---------------------------------------------------------------

   double ema20[];
   double ema50[];
   double ema200[];
   double rsi[];
   double atr[];

   ArrayResize(ema20, 3);
   ArrayResize(ema50, 3);
   ArrayResize(ema200, 3);
   ArrayResize(rsi, 3);
   ArrayResize(atr, 3);

   ArraySetAsSeries(ema20, true);
   ArraySetAsSeries(ema50, true);
   ArraySetAsSeries(ema200, true);
   ArraySetAsSeries(rsi, true);
   ArraySetAsSeries(atr, true);

   if(CopyBuffer(EMA20Handle, 0, 0, 3, ema20) != 3)
   {
      Print("REJECT: EMA20 unavailable.");
      return;
   }

   if(CopyBuffer(EMA50Handle, 0, 0, 3, ema50) != 3)
   {
      Print("REJECT: EMA50 unavailable.");
      return;
   }

   if(CopyBuffer(EMA200Handle, 0, 0, 3, ema200) != 3)
   {
      Print("REJECT: EMA200 unavailable.");
      return;
   }

   if(CopyBuffer(RSIHandle, 0, 0, 3, rsi) != 3)
   {
      Print("REJECT: RSI unavailable.");
      return;
   }

   if(CopyBuffer(ATRHandle, 0, 0, 3, atr) != 3)
   {
      Print("REJECT: ATR unavailable.");
      return;
   }

   //---------------------------------------------------------------
   // CLOSED CANDLES
   //
   // [0] = new/current candle
   // [1] = completed confirmation candle
   // [2] = candle before confirmation
   //---------------------------------------------------------------

   double open1 =
      iOpen(TradeSymbol, TradeTimeframe, 1);

   double high1 =
      iHigh(TradeSymbol, TradeTimeframe, 1);

   double low1 =
      iLow(TradeSymbol, TradeTimeframe, 1);

   double close1 =
      iClose(TradeSymbol, TradeTimeframe, 1);

   double open2 =
      iOpen(TradeSymbol, TradeTimeframe, 2);

   double high2 =
      iHigh(TradeSymbol, TradeTimeframe, 2);

   double low2 =
      iLow(TradeSymbol, TradeTimeframe, 2);

   double close2 =
      iClose(TradeSymbol, TradeTimeframe, 2);

   //---------------------------------------------------------------
   // LOG MARKET STATE
   //---------------------------------------------------------------

   LogMarketState(
      ema20[1],
      ema50[1],
      ema200[1],
      rsi[1],
      atr[1],
      open1,
      high1,
      low1,
      close1,
      spread
   );

   //---------------------------------------------------------------
   // BUY
   //---------------------------------------------------------------

   bool buyTrend =
      ema50[1] > ema200[1];

   bool buyAbove200 =
      close1 > ema200[1];

   bool buyPullback =
      IsPullback(
         close1,
         ema20[1],
         ema50[1],
         atr[1]
      );

   bool buyRSI =
      rsi[2] < RSILevel &&
      rsi[1] > RSILevel;

   //---------------------------------------------------------------
   // BULLISH CANDLE
   //---------------------------------------------------------------

   string buyPattern = "";

   bool buyCandle =
      CheckBullishPattern(
         1,
         buyPattern
      );

   //---------------------------------------------------------------
   // LIQUIDITY
   //---------------------------------------------------------------

   double referenceLow = 0.0;

   bool buySweep =
      FindBuyLiquiditySweep(
         referenceLow
      );

   //---------------------------------------------------------------
   // LOG BUY CONDITIONS
   //---------------------------------------------------------------

   Print("BUY CONDITIONS");
   Print("Trend EMA50 > EMA200 : ", BoolText(buyTrend));
   Print("Close > EMA200       : ", BoolText(buyAbove200));
   Print("Pullback             : ", BoolText(buyPullback));
   Print(
      "RSI ",
      DoubleToString(rsi[2], 2),
      " -> ",
      DoubleToString(rsi[1], 2),
      " : ",
      BoolText(buyRSI)
   );

   Print(
      "Candle Pattern       : ",
      buyCandle ? buyPattern : "NONE"
   );

   if(RequireLiquiditySweep)
   {
      Print(
         "Liquidity Sweep      : ",
         BoolText(buySweep)
      );

      if(buySweep)
      {
         Print(
            "Swept Previous LOW   : ",
            DoubleToString(referenceLow, DigitsSymbol())
         );
      }
   }

   //---------------------------------------------------------------
   // BUY SIGNAL
   //---------------------------------------------------------------

   if(
      buyTrend &&
      buyAbove200 &&
      buyPullback &&
      buyRSI &&
      buyCandle &&
      (!RequireLiquiditySweep || buySweep)
   )
   {
      Print("####################################################");
      Print("BUY SIGNAL CONFIRMED");
      Print("Pattern = ", buyPattern);
      Print("####################################################");

      ExecuteBuy(
         atr[1],
         referenceLow,
         buyPattern
      );

      return;
   }

   //---------------------------------------------------------------
   // SELL
   //---------------------------------------------------------------

   bool sellTrend =
      ema50[1] < ema200[1];

   bool sellBelow200 =
      close1 < ema200[1];

   bool sellPullback =
      IsPullback(
         close1,
         ema20[1],
         ema50[1],
         atr[1]
      );

   bool sellRSI =
      rsi[2] > RSILevel &&
      rsi[1] < RSILevel;

   string sellPattern = "";

   bool sellCandle =
      CheckBearishPattern(
         1,
         sellPattern
      );

   double referenceHigh = 0.0;

   bool sellSweep =
      FindSellLiquiditySweep(
         referenceHigh
      );

   //---------------------------------------------------------------
   // LOG SELL CONDITIONS
   //---------------------------------------------------------------

   Print("SELL CONDITIONS");
   Print("Trend EMA50 < EMA200 : ", BoolText(sellTrend));
   Print("Close < EMA200       : ", BoolText(sellBelow200));
   Print("Pullback             : ", BoolText(sellPullback));

   Print(
      "RSI ",
      DoubleToString(rsi[2], 2),
      " -> ",
      DoubleToString(rsi[1], 2),
      " : ",
      BoolText(sellRSI)
   );

   Print(
      "Candle Pattern       : ",
      sellCandle ? sellPattern : "NONE"
   );

   if(RequireLiquiditySweep)
   {
      Print(
         "Liquidity Sweep      : ",
         BoolText(sellSweep)
      );

      if(sellSweep)
      {
         Print(
            "Swept Previous HIGH  : ",
            DoubleToString(referenceHigh, DigitsSymbol())
         );
      }
   }

   //---------------------------------------------------------------
   // SELL SIGNAL
   //---------------------------------------------------------------

   if(
      sellTrend &&
      sellBelow200 &&
      sellPullback &&
      sellRSI &&
      sellCandle &&
      (!RequireLiquiditySweep || sellSweep)
   )
   {
      Print("####################################################");
      Print("SELL SIGNAL CONFIRMED");
      Print("Pattern = ", sellPattern);
      Print("####################################################");

      ExecuteSell(
         atr[1],
         referenceHigh,
         sellPattern
      );

      return;
   }

   Print("No complete trading signal.");
}

//====================================================================
// PULLBACK
//====================================================================

bool IsPullback(
   double closePrice,
   double ema20,
   double ema50,
   double atr
)
{
   double distance20 =
      MathAbs(closePrice - ema20);

   double distance50 =
      MathAbs(closePrice - ema50);

   double maximumDistance =
      PullbackATRMultiplier * atr;

   return
      distance20 <= maximumDistance ||
      distance50 <= maximumDistance;
}

//====================================================================
// BUY LIQUIDITY SWEEP
//====================================================================

bool FindBuyLiquiditySweep(
   double &referenceLow
)
{
   double fractalLows[];

   ArrayResize(
      fractalLows,
      SwingLookback + 10
   );

   ArraySetAsSeries(
      fractalLows,
      true
   );

   int copied =
      CopyBuffer(
         FractalHandle,
         1,
         0,
         SwingLookback + 10,
         fractalLows
      );

   if(copied <= 0)
   {
      Print("Unable to read fractal lows.");
      return false;
   }

   double confirmationLow =
      iLow(
         TradeSymbol,
         TradeTimeframe,
         1
      );

   double confirmationClose =
      iClose(
         TradeSymbol,
         TradeTimeframe,
         1
      );

   //---------------------------------------------------------------
   // Start at shift 2.
   //
   // A fractal at shift 2 is already confirmed because candle 1
   // and the newly opened candle 0 exist after it.
   //---------------------------------------------------------------

   for(int shift = 2; shift < copied; shift++)
   {
      if(fractalLows[shift] == EMPTY_VALUE)
         continue;

      if(fractalLows[shift] <= 0)
         continue;

      double previousLow =
         fractalLows[shift];

      //------------------------------------------------------------
      // LIQUIDITY SWEEP
      //
      // Price must go BELOW previous low.
      //------------------------------------------------------------

      bool swept =
         confirmationLow < previousLow;

      //------------------------------------------------------------
      // RECLAIM
      //
      // Candle must close ABOVE previous low.
      //------------------------------------------------------------

      bool reclaimed =
         confirmationClose > previousLow;

      if(swept && reclaimed)
      {
         referenceLow = previousLow;

         Print(
            "BUY LIQUIDITY SWEEP CONFIRMED | ",
            "Reference Low=",
            DoubleToString(
               referenceLow,
               DigitsSymbol()
            ),
            " Sweep Low=",
            DoubleToString(
               confirmationLow,
               DigitsSymbol()
            ),
            " Close=",
            DoubleToString(
               confirmationClose,
               DigitsSymbol()
            )
         );

         return true;
      }
   }

   return false;
}

//====================================================================
// SELL LIQUIDITY SWEEP
//====================================================================

bool FindSellLiquiditySweep(
   double &referenceHigh
)
{
   double fractalHighs[];

   ArrayResize(
      fractalHighs,
      SwingLookback + 10
   );

   ArraySetAsSeries(
      fractalHighs,
      true
   );

   int copied =
      CopyBuffer(
         FractalHandle,
         0,
         0,
         SwingLookback + 10,
         fractalHighs
      );

   if(copied <= 0)
   {
      Print("Unable to read fractal highs.");
      return false;
   }

   double confirmationHigh =
      iHigh(
         TradeSymbol,
         TradeTimeframe,
         1
      );

   double confirmationClose =
      iClose(
         TradeSymbol,
         TradeTimeframe,
         1
      );

   for(int shift = 2; shift < copied; shift++)
   {
      if(fractalHighs[shift] == EMPTY_VALUE)
         continue;

      if(fractalHighs[shift] <= 0)
         continue;

      double previousHigh =
         fractalHighs[shift];

      //------------------------------------------------------------
      // LIQUIDITY SWEEP
      //------------------------------------------------------------

      bool swept =
         confirmationHigh > previousHigh;

      //------------------------------------------------------------
      // RECLAIM
      //------------------------------------------------------------

      bool reclaimed =
         confirmationClose < previousHigh;

      if(swept && reclaimed)
      {
         referenceHigh = previousHigh;

         Print(
            "SELL LIQUIDITY SWEEP CONFIRMED | ",
            "Reference High=",
            DoubleToString(
               referenceHigh,
               DigitsSymbol()
            ),
            " Sweep High=",
            DoubleToString(
               confirmationHigh,
               DigitsSymbol()
            ),
            " Close=",
            DoubleToString(
               confirmationClose,
               DigitsSymbol()
            )
         );

         return true;
      }
   }

   return false;
}

//====================================================================
// BUY CANDLE PATTERNS
//====================================================================

bool CheckBullishPattern(
   int shift,
   string &pattern
)
{
   pattern = "";

   if(!UseCandlestickFilter)
   {
      if(
         iClose(
            TradeSymbol,
            TradeTimeframe,
            shift
         ) >
         iOpen(
            TradeSymbol,
            TradeTimeframe,
            shift
         )
      )
      {
         pattern = "BULLISH_CLOSE";
         return true;
      }

      return false;
   }

   //---------------------------------------------------------------
   // Previous candle RED
   //---------------------------------------------------------------

   bool previousRed =
      iClose(
         TradeSymbol,
         TradeTimeframe,
         shift + 1
      )
      <
      iOpen(
         TradeSymbol,
         TradeTimeframe,
         shift + 1
      );

   if(
      BuyPatternRequiresPrevRed &&
      !previousRed
   )
   {
      return false;
   }

   //---------------------------------------------------------------
   // Patterns
   //---------------------------------------------------------------

   if(
      EnableBullishEngulfing &&
      IsBullishEngulfing(shift)
   )
   {
      pattern = "BULLISH_ENGULFING";
      return true;
   }

   if(
      EnableHammer &&
      IsHammer(shift)
   )
   {
      pattern = "HAMMER";
      return true;
   }

   if(
      EnableDragonflyDoji &&
      IsDragonflyDoji(shift)
   )
   {
      pattern = "DRAGONFLY_DOJI";
      return true;
   }

   if(
      EnableInvertedHammer &&
      IsInvertedHammer(shift)
   )
   {
      pattern = "INVERTED_HAMMER";
      return true;
   }

   if(
      EnableBullishInsideBar &&
      IsBullishInsideBar(shift)
   )
   {
      pattern = "BULLISH_INSIDE_BAR";
      return true;
   }

   return false;
}

