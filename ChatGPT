//====================================================================
// EXECUTE BUY
//====================================================================

void ExecuteBuy(
   double atr,
   double sweptLow,
   string pattern
)
{
   MqlTick tick;

   if(!SymbolInfoTick(
      TradeSymbol,
      tick
   ))
   {
      Print("BUY REJECTED: Cannot get tick.");
      return;
   }

   double entry =
      tick.ask;

   //---------------------------------------------------------------
   // SL based on swept previous LOW
   //---------------------------------------------------------------

   double sl =
      sweptLow -
      (SL_ATR_Buffer * atr);

   sl =
      NormalizePrice(sl);

   if(sl >= entry)
   {
      Print("BUY REJECTED: SL >= Entry.");
      return;
   }

   //---------------------------------------------------------------
   // Find previous confirmed HIGH for TP
   //---------------------------------------------------------------

   double targetHigh = 0.0;

   if(!FindPreviousSwingHigh(targetHigh))
   {
      Print(
         "BUY REJECTED: No confirmed previous swing HIGH."
      );

      return;
   }

   targetHigh =
      NormalizePrice(targetHigh);

   //---------------------------------------------------------------
   // Risk
   //---------------------------------------------------------------

   double riskDistance =
      entry - sl;

   if(riskDistance <= 0)
   {
      Print("BUY REJECTED: Invalid risk distance.");
      return;
   }

   //---------------------------------------------------------------
   // TP based on previous confirmed HIGH
   //---------------------------------------------------------------

   double tp =
      targetHigh;

   double rewardDistance =
      tp - entry;

   if(rewardDistance <= 0)
   {
      Print(
         "BUY REJECTED: Previous HIGH is below entry."
      );

      return;
   }

   double actualRR =
      rewardDistance /
      riskDistance;

   //---------------------------------------------------------------
   // Minimum RR
   //---------------------------------------------------------------

   if(
      RequireMinimumRR &&
      actualRR < MinimumRiskReward
   )
   {
      Print(
         "BUY REJECTED: Previous HIGH gives RR=",
         DoubleToString(actualRR, 2),
         " < required ",
         DoubleToString(
            MinimumRiskReward,
            2
         )
      );

      return;
   }

   //---------------------------------------------------------------
   // Broker stop validation
   //---------------------------------------------------------------

   if(!ValidateStops(
      ORDER_TYPE_BUY,
      entry,
      sl,
      tp
   ))
   {
      Print("BUY REJECTED: Broker stop-distance rule.");
      return;
   }

   //---------------------------------------------------------------
   // Calculate lot
   //---------------------------------------------------------------

   double lot =
      CalculateLotSize(
         ORDER_TYPE_BUY,
         entry,
         sl
      );

   if(lot <= 0)
   {
      Print("BUY REJECTED: Invalid calculated lot.");
      return;
   }

   //---------------------------------------------------------------
   // Detailed signal
   //---------------------------------------------------------------

   Print("====================================================");
   Print("BUY TRADE DETAILS");
   Print("====================================================");

   Print("Pattern              : ", pattern);
   Print("Entry                : ",
         DoubleToString(entry, DigitsSymbol()));

   Print("Swept Previous LOW   : ",
         DoubleToString(sweptLow, DigitsSymbol()));

   Print("SL                   : ",
         DoubleToString(sl, DigitsSymbol()));

   Print("Previous Swing HIGH  : ",
         DoubleToString(targetHigh, DigitsSymbol()));

   Print("TP                   : ",
         DoubleToString(tp, DigitsSymbol()));

   Print("Risk Distance        : ",
         DoubleToString(riskDistance, DigitsSymbol()));

   Print("Reward Distance      : ",
         DoubleToString(rewardDistance, DigitsSymbol()));

   Print("RR                   : ",
         DoubleToString(actualRR, 2));

   Print("Lot                  : ",
         DoubleToString(lot, VolumeDigits()));

   Print("Risk %               : ",
         RiskPercent);

   //---------------------------------------------------------------
   // CSV
   //---------------------------------------------------------------

   LogTradeCSV(
      "BUY_SIGNAL",
      pattern,
      entry,
      sl,
      tp,
      lot,
      sweptLow,
      targetHigh,
      actualRR
   );

   //---------------------------------------------------------------
   // SEND ORDER
   //---------------------------------------------------------------

   bool result =
      trade.Buy(
         lot,
         TradeSymbol,
         0.0,
         sl,
         tp,
         "XAUUSD LS BUY"
      );

   if(!result)
   {
      Print(
         "BUY ORDER FAILED | Retcode=",
         trade.ResultRetcode(),
         " | ",
         trade.ResultRetcodeDescription()
      );

      LogTradeCSV(
         "BUY_FAILED",
         pattern,
         entry,
         sl,
         tp,
         lot,
         sweptLow,
         targetHigh,
         actualRR
      );

      return;
   }

   Print("BUY ORDER SUCCESSFUL");
   Print("Ticket: ", trade.ResultOrder());

   LogTradeCSV(
      "BUY_SENT",
      pattern,
      entry,
      sl,
      tp,
      lot,
      sweptLow,
      targetHigh,
      actualRR
   );
}

