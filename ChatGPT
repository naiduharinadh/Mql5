}

//====================================================================
// LOT CALCULATION
//====================================================================

double CalculateLotSize(
   ENUM_ORDER_TYPE orderType,
   double entry,
   double stopLoss
)
{
   double equity =
      AccountInfoDouble(
         ACCOUNT_EQUITY
      );

   double riskMoney =
      equity *
      RiskPercent /
      100.0;

   if(riskMoney <= 0)
      return 0;

   double oneLotProfit = 0.0;

   if(!OrderCalcProfit(
      orderType,
      TradeSymbol,
      1.0,
      entry,
      stopLoss,
      oneLotProfit
   ))
   {
      Print(
         "OrderCalcProfit failed. Error=",
         GetLastError()
      );

      return 0;
   }

   double oneLotLoss =
      MathAbs(oneLotProfit);

   if(oneLotLoss <= 0)
      return 0;

   double lot =
      riskMoney /
      oneLotLoss;

   //---------------------------------------------------------------
   // Broker volume limits
   //---------------------------------------------------------------

   double minLot =
      SymbolInfoDouble(
         TradeSymbol,
         SYMBOL_VOLUME_MIN
      );

   double maxLot =
      SymbolInfoDouble(
         TradeSymbol,
         SYMBOL_VOLUME_MAX
      );

   double step =
      SymbolInfoDouble(
         TradeSymbol,
         SYMBOL_VOLUME_STEP
      );

   if(step <= 0)
      return 0;

   //---------------------------------------------------------------
   // Safety: don't exceed maximum
   //---------------------------------------------------------------

   if(lot > maxLot)
      lot = maxLot;

   //---------------------------------------------------------------
   // If below minimum, reject
   //---------------------------------------------------------------

   if(lot < minLot)
   {
      Print(
         "Calculated lot ",
         lot,
         " is below broker minimum ",
         minLot
      );

      return 0;
   }

   //---------------------------------------------------------------
   // Round DOWN to volume step
   //---------------------------------------------------------------

   lot =
      MathFloor(
         lot / step
      ) * step;

   if(lot < minLot)
      return 0;

   return NormalizeVolume(lot);
}

//====================================================================
// NORMALIZE VOLUME
//====================================================================

double NormalizeVolume(
   double volume
)
{
   double step =
      SymbolInfoDouble(
         TradeSymbol,
         SYMBOL_VOLUME_STEP
      );

   if(step <= 0)
      return volume;

   int digits = 2;

   if(step >= 1.0)
      digits = 0;
   else if(step >= 0.1)
      digits = 1;
   else if(step >= 0.01)
      digits = 2;
   else
      digits = 3;

   return NormalizeDouble(
      volume,
      digits
   );
}

//====================================================================
// VALIDATE STOPS
//====================================================================

bool ValidateStops(
   ENUM_ORDER_TYPE orderType,
   double entry,
   double sl,
   double tp
)
{
   double point =
      SymbolInfoDouble(
         TradeSymbol,
         SYMBOL_POINT
      );

   if(point <= 0)
      return false;

   long stopsLevel =
      SymbolInfoInteger(
         TradeSymbol,
         SYMBOL_TRADE_STOPS_LEVEL
      );

   double minimumDistance =
      stopsLevel * point;

   if(orderType == ORDER_TYPE_BUY)
   {
      if(
         entry - sl <
         minimumDistance
      )
      {
         Print(
            "BUY SL too close. Required=",
            minimumDistance
         );

         return false;
      }

      if(
         tp - entry <
         minimumDistance
      )
      {
         Print(
            "BUY TP too close. Required=",
            minimumDistance
         );

         return false;
      }
   }

   if(orderType == ORDER_TYPE_SELL)
   {
      if(
         sl - entry <
         minimumDistance
      )
      {
         Print(
            "SELL SL too close. Required=",
            minimumDistance
         );

         return false;
      }

      if(
         entry - tp <
         minimumDistance
      )
      {
         Print(
            "SELL TP too close. Required=",
            minimumDistance
         );

         return false;
      }
   }

   return true;
}

//====================================================================
// OPEN POSITIONS
//====================================================================

int CountOurPositions()
{
   int count = 0;

   for(
      int i = PositionsTotal() - 1;
      i >= 0;
      i--
   )
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(
         !PositionSelectByTicket(ticket)
      )
         continue;

      string symbol =
         PositionGetString(
            POSITION_SYMBOL
         );

      ulong magic =
         (ulong)PositionGetInteger(
            POSITION_MAGIC
         );

      if(
         symbol == TradeSymbol &&
         magic == MagicNumber
      )
      {
         count++;
      }
   }

   return count;
}

//====================================================================
// SPREAD
//====================================================================

double GetSpreadPoints()
{
   MqlTick tick;

   if(
      !SymbolInfoTick(
         TradeSymbol,
         tick
      )
   )
      return 999999;

   double point =
      SymbolInfoDouble(
         TradeSymbol,
         SYMBOL_POINT
      );

   if(point <= 0)
      return 999999;

   return
      (tick.ask - tick.bid) /
      point;
}

//====================================================================
// SESSION
//====================================================================

bool IsTradingSession()
{
   MqlDateTime dt;

   TimeToStruct(
      TimeCurrent(),
      dt
   );

   int currentMinutes =
      dt.hour * 60 +
      dt.min;

   bool london = false;
   bool newYork = false;

   if(UseLondonSession)
   {
      int start =
         ConvertTimeToMinutes(
            LondonStart
         );

      int end =
         ConvertTimeToMinutes(
            LondonEnd
         );

      london =
         IsInsideTime(
            currentMinutes,
            start,
            end
         );
   }

   if(UseNewYorkSession)
   {
      int start =
         ConvertTimeToMinutes(
            NewYorkStart
         );

      int end =
         ConvertTimeToMinutes(
            NewYorkEnd
         );

      newYork =
         IsInsideTime(
            currentMinutes,
            start,
            end
         );
   }

   return london || newYork;
}

//====================================================================
// TIME STRING
//====================================================================

int ConvertTimeToMinutes(
   string timeText
)
{
   string parts[];

   int count =
      StringSplit(
         timeText,
         ':',
         parts
      );

   if(count != 2)
      return 0;

   int hour =
      (int)StringToInteger(
         parts[0]
      );

   int minute =
      (int)StringToInteger(
         parts[1]
      );

   return
      hour * 60 +
      minute;
}

//====================================================================
// SESSION WINDOW
//====================================================================

bool IsInsideTime(
   int current,
   int start,
   int end
)
{
   if(start <= end)
   {
      return
         current >= start &&
         current <= end;
   }

   return
      current >= start ||
      current <= end;
}

//====================================================================
// DAILY LOSS
//====================================================================

bool CheckDailyLoss()
{
   if(MaxDailyLossPercent <= 0)
      return true;

   string key =
      "XAU_LS_START_EQ_" +
      IntegerToString(
         (long)AccountInfoInteger(
            ACCOUNT_LOGIN
         )
      );

   MqlDateTime dt;

   TimeToStruct(
      TimeCurrent(),
      dt
   );

   string day =
      IntegerToString(dt.year) +
      "_" +
      IntegerToString(dt.mon) +
      "_" +
      IntegerToString(dt.day);

   string fullKey =
      key + "_" + day;

   //---------------------------------------------------------------
   // First check of the day
   //---------------------------------------------------------------

   if(
      !GlobalVariableCheck(
         fullKey
      )
   )
   {
      GlobalVariableSet(
         fullKey,
         AccountInfoDouble(
            ACCOUNT_EQUITY
         )
      );

      return true;
   }

   double startEquity =
      GlobalVariableGet(
         fullKey
      );

   double currentEquity =
      AccountInfoDouble(
         ACCOUNT_EQUITY
      );

   if(startEquity <= 0)
      return true;

   double lossPercent =
      (
         (startEquity - currentEquity)
         /
         startEquity
      )
      * 100.0;

   if(
      lossPercent >=
      MaxDailyLossPercent
   )
   {
      Print(
         "DAILY LOSS LIMIT HIT: ",
         DoubleToString(
            lossPercent,
            2
         ),
         "%"
      );

      return false;
   }

   return true;
}

//====================================================================
// DAILY TRADE LIMIT
//====================================================================

bool CheckDailyTradeLimit()
{
   if(MaxDailyTrades <= 0)
      return true;

   datetime dayStart =
      GetDayStart();

   if(
      !HistorySelect(
         dayStart,
         TimeCurrent()
      )
   )
      return true;

   int count = 0;

   int total =
      HistoryDealsTotal();

   for(int i = 0; i < total; i++)
   {
      ulong ticket =
         HistoryDealGetTicket(i);

      if(ticket == 0)
         continue;

      string symbol =
         HistoryDealGetString(
            ticket,
            DEAL_SYMBOL
         );

      ulong magic =
         (ulong)HistoryDealGetInteger(
            ticket,
            DEAL_MAGIC
         );

      long entry =
         HistoryDealGetInteger(
            ticket,
            DEAL_ENTRY
         );

      if(
         symbol == TradeSymbol &&
         magic == MagicNumber &&
         entry == DEAL_ENTRY_IN
      )
      {
         count++;
      }
   }

   return count < MaxDailyTrades;
}

//====================================================================
// DAY START
//====================================================================

datetime GetDayStart()
{
   MqlDateTime dt;

   TimeToStruct(
      TimeCurrent(),
      dt
   );

   dt.hour = 0;
   dt.min = 0;
   dt.sec = 0;

   return StructToTime(dt);
}

//====================================================================
// PRICE DIGITS
//====================================================================

int DigitsSymbol()
{
   return
      (int)SymbolInfoInteger(
         TradeSymbol,
         SYMBOL_DIGITS
      );
}

//====================================================================
// VOLUME DIGITS
//====================================================================

int VolumeDigits()
{
   double step =
      SymbolInfoDouble(
         TradeSymbol,
         SYMBOL_VOLUME_STEP
      );

   if(step >= 1.0)
      return 0;

   if(step >= 0.1)
      return 1;

   if(step >= 0.01)
      return 2;

   return 3;
}

//====================================================================
// PRICE NORMALIZATION
//====================================================================

double NormalizePrice(
   double price
)
{
   return NormalizeDouble(
      price,
      DigitsSymbol()
   );
}

//====================================================================
// BOOLEAN TEXT
//====================================================================

string BoolText(
   bool value
)
{
   return value ? "YES" : "NO";
}

