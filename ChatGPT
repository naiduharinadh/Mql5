//====================================================================
// CANDLE CALCULATIONS
//====================================================================

double CandleBody(int shift)
{
   double open =
      iOpen(
         TradeSymbol,
         TradeTimeframe,
         shift
      );

   double close =
      iClose(
         TradeSymbol,
         TradeTimeframe,
         shift
      );

   return MathAbs(close - open);
}

//--------------------------------------------------------------------

double UpperWick(int shift)
{
   double open =
      iOpen(
         TradeSymbol,
         TradeTimeframe,
         shift
      );

   double close =
      iClose(
         TradeSymbol,
         TradeTimeframe,
         shift
      );

   double high =
      iHigh(
         TradeSymbol,
         TradeTimeframe,
         shift
      );

   return high - MathMax(open, close);
}

//--------------------------------------------------------------------

double LowerWick(int shift)
{
   double open =
      iOpen(
         TradeSymbol,
         TradeTimeframe,
         shift
      );

   double close =
      iClose(
         TradeSymbol,
         TradeTimeframe,
         shift
      );

   double low =
      iLow(
         TradeSymbol,
         TradeTimeframe,
         shift
      );

   return MathMin(open, close) - low;
}

//--------------------------------------------------------------------

double CandleRange(int shift)
{
   return
      iHigh(
         TradeSymbol,
         TradeTimeframe,
         shift
      )
      -
      iLow(
         TradeSymbol,
         TradeTimeframe,
         shift
      );
}

//====================================================================
// BULLISH ENGULFING
//====================================================================

bool IsBullishEngulfing(int shift)
{
   double open1 =
      iOpen(TradeSymbol, TradeTimeframe, shift);

   double close1 =
      iClose(TradeSymbol, TradeTimeframe, shift);

   double open2 =
      iOpen(TradeSymbol, TradeTimeframe, shift + 1);

   double close2 =
      iClose(TradeSymbol, TradeTimeframe, shift + 1);

   if(close1 <= open1)
      return false;

   if(close2 >= open2)
      return false;

