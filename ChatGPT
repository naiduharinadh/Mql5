//====================================================================
// FIND PREVIOUS SWING HIGH
//====================================================================

bool FindPreviousSwingHigh(
   double &swingHigh
)
{
   double highs[];

   ArrayResize(
      highs,
      SwingLookback + 10
   );

   ArraySetAsSeries(
      highs,
      true
   );

   int copied =
      CopyBuffer(
         FractalHandle,
         0,
         0,
         SwingLookback + 10,
         highs
      );

   if(copied <= 0)
      return false;

   for(int shift = 2; shift < copied; shift++)
   {
      if(highs[shift] == EMPTY_VALUE)
         continue;

      if(highs[shift] <= 0)
         continue;

      swingHigh = highs[shift];

      return true;
   }

   return false;
}

